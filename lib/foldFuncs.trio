name:lastVal
doc:"Fold function to return last non-null value. Return 'null' if no values."
func
overridable
src:
  (val, acc) => do
    // Start
    if (val == foldStart()) do
      return null
  
    // End
    else if (val == foldEnd()) do
      return acc
  
    // Accumulate: last non-null value
    else if (val != null) do
      return val
    else do
      return acc
    end
  end
